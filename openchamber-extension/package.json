{
  "name": "openchamber-enhanced-prompt-card",
  "version": "0.1.10",
  "private": true,
  "description": "增强提示卡 设置与诊断面板（OpenChamber 扩展）",
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.0"
    },
    "contributes": {
      "panel": {
        "id": "enhanced-prompt-card",
        "name": "增强提示卡 / Enhanced Prompt Card",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "filesystem": [
        "~/.config/opencode/enhanced-prompt-card.json",
        "~/.config/opencode/enhanced-prompt-card-models.json",
        "~/.config/opencode/enhanced-prompt-card-events.jsonl",
        "~/.config/opencode/agents",
        "~/.config/opencode/agents/**"
      ],
      "attach": false
    }
  }
}
